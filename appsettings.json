{
    "ServiceConfig": {
        "IntervalMinutes": 5,
        "IpAddressEndpoint": "https://api.ipify.org",
        "NotificationEndpoint": "https://<next-dns-link-ip-endpoint>"
    },

    "Serilog": {
        "Using": [
            "Serilog.Sinks.File"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Warning",
                "System.Net.Http.HttpClient": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "File",
                "Args": {
                    "path": "C:\\ProgramData\\NextDNSIPMonitor\\logs\\service-.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 30,
                    "shared": true
                }
            }
        ]
    }
}